<UserControl x:Class="XXAR.Uninstall.Steps.ChoicesStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:XXAR.Wizard">
    <wizard:WizardFrame x:Name="Frame" Heading="Uninstall XXAR">
        <StackPanel Margin="20,18,20,10">
            <TextBlock Text="Choose what to remove, then click Uninstall."
                       Foreground="{DynamicResource XXARTextSecondaryBrush}"
                       FontSize="12" Margin="0,0,0,14" />

            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding Selected, Mode=OneTime}"
                                      IsEnabled="{Binding CanDeselect}"
                                      Checked="Selection_Changed" Unchecked="Selection_Changed"
                                      VerticalAlignment="Top">
                                <StackPanel Margin="4,-2,0,0">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource XXARTextPrimaryBrush}"
                                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{DynamicResource XXARTextSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </CheckBox>

                            <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                       Foreground="{DynamicResource XXARTextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Top" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="TotalLabel"
                       Foreground="{DynamicResource XXARTextPrimaryBrush}"
                       FontSize="12" Margin="0,6,0,0" />
        </StackPanel>

        <wizard:WizardFrame.Buttons>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,20,0">
                <Button Content="Uninstall" Click="Remove_Click"
                        Style="{StaticResource XXARPrimaryButton}" Margin="4,0" />
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource XXARSecondaryButton}" Margin="12,0,0,0" />
            </StackPanel>
        </wizard:WizardFrame.Buttons>
    </wizard:WizardFrame>
</UserControl>
