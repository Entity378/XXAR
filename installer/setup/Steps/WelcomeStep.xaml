<UserControl x:Class="XXAR.Setup.Steps.WelcomeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:XXAR.Wizard">
    <wizard:WizardFrame UseSidebar="True"
                       Heading="Welcome to the XXAR Installer"
                       Subheading="The installer will set up XXAR on your computer. Click Next to continue or Cancel to exit.">
        <wizard:WizardFrame.Buttons>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,20,0">
                <Button Content="Back" IsEnabled="False"
                        Style="{StaticResource XXARSecondaryButton}" Margin="4,0" />
                <Button Content="Next" Click="GoNext_Click"
                        Style="{StaticResource XXARPrimaryButton}" Margin="4,0" />
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource XXARSecondaryButton}" Margin="12,0,0,0" />
            </StackPanel>
        </wizard:WizardFrame.Buttons>
    </wizard:WizardFrame>
</UserControl>
