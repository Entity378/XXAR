<UserControl x:Class="XXAR.Setup.Steps.MaintenanceStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:XXAR.Wizard">
    <wizard:WizardFrame Heading="Modify XXAR"
                       Subheading="Choose whether to repair the installed files or remove XXAR from your computer.">
        <StackPanel Margin="20,24,20,10">
            <Button Click="Repair_Click" Style="{StaticResource XXARSecondaryButton}"
                    Margin="0,0,0,12" HorizontalContentAlignment="Left" Padding="16,12" Height="Auto">
                <StackPanel>
                    <TextBlock Text="Repair"
                               Foreground="{DynamicResource XXARTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Reinstall the current version of XXAR, replacing any missing or corrupted files."
                               Foreground="{DynamicResource XXARTextSecondaryBrush}"
                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button Click="Remove_Click" Style="{StaticResource XXARSecondaryButton}"
                    HorizontalContentAlignment="Left" Padding="16,12" Height="Auto">
                <StackPanel>
                    <TextBlock Text="Uninstall"
                               Foreground="{DynamicResource XXARTextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Remove XXAR and its downloaded tools and caches from this computer."
                               Foreground="{DynamicResource XXARTextSecondaryBrush}"
                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </StackPanel>

        <wizard:WizardFrame.Buttons>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,20,0">
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource XXARSecondaryButton}" Margin="4,0" />
            </StackPanel>
        </wizard:WizardFrame.Buttons>
    </wizard:WizardFrame>
</UserControl>
