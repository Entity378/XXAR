<UserControl x:Class="XXAR.Setup.Steps.ProgressStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:XXAR.Wizard"
             Loaded="Step_Loaded">
    <wizard:WizardFrame x:Name="Frame"
                       Heading="Installing XXAR"
                       Subheading="Please wait while XXAR is installed on your computer.">
        <StackPanel Margin="20,24,20,10">
            <StackPanel Orientation="Horizontal" MinHeight="20">
                <TextBlock Text="Status:"
                           Foreground="{DynamicResource XXARTextSecondaryBrush}" FontSize="12" />
                <TextBlock x:Name="CurrentAction"
                           Foreground="{DynamicResource XXARTextPrimaryBrush}"
                           FontSize="12" Margin="6,0,0,0" />
            </StackPanel>
            <ProgressBar x:Name="Bar" Height="8" Margin="0,12,0,0" Maximum="100"
                         Background="#0E1030"
                         Foreground="{DynamicResource XXARAccentBrush}"
                         BorderBrush="{DynamicResource XXARBorderBrush}"
                         BorderThickness="1" />
        </StackPanel>

        <wizard:WizardFrame.Buttons>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,20,0">
                <Button Content="Back" IsEnabled="False"
                        Style="{StaticResource XXARSecondaryButton}" Margin="4,0" />
                <Button Content="Next" IsEnabled="False"
                        Style="{StaticResource XXARPrimaryButton}" Margin="4,0" />
                <Button x:Name="Cancel" Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource XXARSecondaryButton}" Margin="12,0,0,0" />
            </StackPanel>
        </wizard:WizardFrame.Buttons>
    </wizard:WizardFrame>
</UserControl>
