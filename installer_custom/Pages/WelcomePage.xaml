<UserControl x:Class="XXAR.Setup.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource XXARWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="53" />
        </Grid.RowDefinitions>

        <!-- Content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0A0B28">
                <Image Source="pack://application:,,,/Assets/XXAR-Logo2-512.png"
                       Margin="20" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <Border Grid.Column="0" HorizontalAlignment="Right" Width="1"
                    Background="{DynamicResource XXARAccentBrush}" />

            <StackPanel Grid.Column="1" Margin="20,25,20,20" VerticalAlignment="Top">
                <TextBlock Text="Welcome to the XXAR Setup Wizard"
                           Foreground="{DynamicResource XXARTextPrimaryBrush}"
                           FontSize="16" TextWrapping="WrapWithOverflow" />
                <TextBlock Text="The Setup Wizard will install XXAR on your computer. Click Next to continue or Cancel to exit the Setup Wizard."
                           Foreground="{DynamicResource XXARTextSecondaryBrush}"
                           FontSize="13" Margin="0,14,0,0"
                           TextWrapping="WrapWithOverflow" LineHeight="20" />
            </StackPanel>
        </Grid>

        <!-- Button bar -->
        <Border Grid.Row="1" Background="#080922"
                BorderBrush="{DynamicResource XXARBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="GoPrev" Content="Back"
                        Style="{StaticResource XXARSecondaryButton}"
                        IsEnabled="False" Margin="4,0" />
                <Button x:Name="GoNext" Content="Next"
                        Style="{StaticResource XXARPrimaryButton}"
                        Click="GoNext_Click" Margin="4,0" />
                <Button x:Name="Cancel" Content="Cancel"
                        Style="{StaticResource XXARSecondaryButton}"
                        Click="Cancel_Click" Margin="12,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
