<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net48 ships with Windows 10 1903+, so the stub needs no runtime install. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>XXAR.Setup</RootNamespace>
    <AssemblyName>XXAR-Setup</AssemblyName>
    <ApplicationIcon>..\installer_ws\Assets\XXAR-Logo2.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The installer's own version, independent of the XXAR release it carries. Bump it when this
         project changes; the app version travels in the payload trailer instead. -->
    <Version>1.0.0</Version>
    <Company>Entity378</Company>
    <Product>XXAR</Product>
    <!-- Fills FileDescription, Comments and LegalCopyright in the version-info resource. -->
    <AssemblyTitle>XXAR Setup</AssemblyTitle>
    <Description>Setup and uninstaller for XXAR, the cross-game audio replacer.</Description>
    <Copyright>Copyright (c) 2026 Entity378 - GPL-3.0</Copyright>
    <!-- Keep ProductVersion clean; the SDK would otherwise append the git commit id. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Same sources must give the same bytes, so two builds of one commit can be compared.
         The symbol file is kept: a release binary without a debug directory is an unusual shape. -->
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <!-- Source Link would write the absolute repository root into the symbol file, which changes
         its checksum and with it the module id and the timestamp of the executable. -->
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Zip support is a separate assembly on net48. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\installer_ws\Assets\XXAR-Logo2-512.png" Link="Assets\XXAR-Logo2-512.png" />
    <Resource Include="..\installer_ws\License.rtf" Link="License.rtf" />
  </ItemGroup>

</Project>
